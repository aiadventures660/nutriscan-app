{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Flutter: Run App",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run"
			],
			"isBackground": true,
			"problemMatcher": [
				"$dart-flutter"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			}
		},
		{
			"label": "Flutter: Get Dependencies",
			"type": "shell",
			"command": "flutter",
			"args": [
				"pub",
				"get"
			],
			"group": "build",
			"problemMatcher": [
				"$dart-flutter"
			]
		},
		{
			"label": "Flutter: Clean",
			"type": "shell",
			"command": "flutter",
			"args": [
				"clean"
			],
			"group": "build"
		},
		{
			"label": "Flutter: Build APK",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build",
				"apk",
				"--release"
			],
			"group": "build",
			"problemMatcher": [
				"$dart-flutter"
			]
		},
		{
			"label": "Flutter: Build App Bundle",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build",
				"appbundle",
				"--release"
			],
			"group": "build",
			"problemMatcher": [
				"$dart-flutter"
			]
		},
		{
			"label": "Flutter: Run Tests",
			"type": "shell",
			"command": "flutter",
			"args": [
				"test"
			],
			"group": "test",
			"problemMatcher": [
				"$dart-flutter"
			]
		},
		{
			"label": "Flutter: Doctor",
			"type": "shell",
			"command": "flutter",
			"args": [
				"doctor",
				"-v"
			],
			"group": "build"
		},
		{
			"label": "Flutter Run",
			"type": "shell",
			"command": "flutter run",
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}